{
  "name": "hdtw-vscode",
  "displayName": "How Does This Work",
  "description": "Guided, rails-driven explanation of how a codebase works from entrypoint to exit.",
  "version": "0.0.1",
  "private": true,
  "publisher": "madeit",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hdtw",
          "title": "How Does This Work",
          "icon": "media/compass.svg"
        }
      ]
    },
    "views": {
      "hdtw": [
        {
          "id": "hdtwTours",
          "name": "Tours"
        }
      ]
    },
    "commands": [
      { "command": "hdtw.refreshTours", "title": "HDTW: Refresh Tours", "icon": "$(refresh)" },
      { "command": "hdtw.startTour", "title": "HDTW: Start Tour" },
      { "command": "hdtw.tourPrevious", "title": "Back", "icon": "$(arrow-left)" },
      { "command": "hdtw.tourNext", "title": "Next", "icon": "$(arrow-right)" },
      { "command": "hdtw.tourExit", "title": "Exit Tour", "icon": "$(close)" },
      { "command": "hdtw.generateTour", "title": "HDTW: Generate Tour…", "icon": "$(sparkle)" },
      { "command": "hdtw.setApiKey", "title": "HDTW: Set Anthropic API Key" }
    ],
    "menus": {
      "view/title": [
        { "command": "hdtw.generateTour", "when": "view == hdtwTours", "group": "navigation@1" },
        { "command": "hdtw.refreshTours", "when": "view == hdtwTours", "group": "navigation@2" }
      ],
      "comments/commentThread/title": [
        { "command": "hdtw.tourPrevious", "when": "commentController == hdtw-tour", "group": "inline@1" },
        { "command": "hdtw.tourNext", "when": "commentController == hdtw-tour", "group": "inline@2" },
        { "command": "hdtw.tourExit", "when": "commentController == hdtw-tour", "group": "inline@3" }
      ]
    },
    "configuration": {
      "title": "How Does This Work",
      "properties": {
        "hdtw.generation.model": {
          "type": "string",
          "default": "",
          "description": "Model for tour generation. Empty uses the agent SDK default."
        },
        "hdtw.generation.maxBudgetUsd": {
          "type": "number",
          "default": 2,
          "description": "Abort tour generation when the estimated cost exceeds this many USD."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@made-i-t/hdtw-engine-server": "workspace:*",
    "@made-i-t/hdtw-protocol": "workspace:*",
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
