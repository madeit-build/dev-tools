{
  "name": "@madeit-build/workspace",
  "version": "0.1.0",
  "description": "Made I.T. workspace context: which project a piece of work is about, how we know, and what else we saw",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeit-build/dev-tools.git",
    "directory": "src/workspace/src/core"
  },
  "exports": {
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "bin": {
    "madeit-workspace": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ignore-pattern dist",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "vitest": "^3.0.0",
    "typescript": "^5.8.3",
    "@types/node": "^20.17.0"
  }
}
